#!/bin/sh
set -e

ILVO_PATH=/var/lib/ilvo
DEFAULTS=/usr/share/artof-core/defaults
LEGACY_BACKUP=/var/lib/ilvo.legacy-upgrade
LEGACY_UNIT=/etc/systemd/system/ilvo-robotics.service
SERVICE=ilvo-robotics.service
REDIS_CONTAINER=redis-stack-server
REDIS_IMAGE=redis/redis-stack-server:7.4.0-v8
SYSTEM_IMAGE=axelwillekens/artof-system

wait_for_redis() {
    for _ in $(seq 30); do
        redis-cli ping >/dev/null 2>&1 && return 0
        sleep 1
    done
    echo "artof-core: Redis did not come up on port 6379" >&2
    return 1
}

[ "$1" = "configure" ] || exit 0

# Settings belong to the robot: restore them after a legacy upgrade and only
# add the defaults that are missing, never overwrite an existing file.
if getent passwd 1000 >/dev/null; then owner=1000:1000; else owner=root:root; fi
mkdir -p "$ILVO_PATH/logs"
if [ -d "$LEGACY_BACKUP" ]; then
    cp -a "$LEGACY_BACKUP/." "$ILVO_PATH/"
    rm -rf "$LEGACY_BACKUP"
fi
(cd "$DEFAULTS" && find . -type f) | while read -r file; do
    [ -e "$ILVO_PATH/$file" ] || install -D -m 644 "$DEFAULTS/$file" "$ILVO_PATH/$file"
done
# Keep the settings editable by the robot user, as before
find "$ILVO_PATH" -user root -exec chown "$owner" {} +

# The old install script wrote its own unit to /etc, which would shadow ours.
if [ -f "$LEGACY_UNIT" ] && grep -q '^ExecStart=ilvo-system-manager' "$LEGACY_UNIT"; then
    systemctl disable "$SERVICE" >/dev/null 2>&1 || true
    rm -f "$LEGACY_UNIT"
fi

# Redis runs in Docker with a pinned image, replaced when the pin changes
if docker container inspect "$REDIS_CONTAINER" >/dev/null 2>&1 \
    && [ "$(docker inspect -f '{{.Config.Image}}' "$REDIS_CONTAINER")" != "$REDIS_IMAGE" ]; then
    docker rm -f "$REDIS_CONTAINER" >/dev/null
fi
if docker container inspect "$REDIS_CONTAINER" >/dev/null 2>&1; then
    docker start "$REDIS_CONTAINER" >/dev/null
else
    docker run -d --restart always --name "$REDIS_CONTAINER" -p 6379:6379 "$REDIS_IMAGE" >/dev/null
fi
wait_for_redis

# The system manager only reads redis.init.json into an empty Redis, so start
# clean after every upgrade
if [ -n "$2" ]; then
    redis-cli FLUSHALL >/dev/null
fi

# Refresh the system addon; the system manager recreates the container
if docker pull -q "$SYSTEM_IMAGE" >/dev/null; then
    docker rm -f system >/dev/null 2>&1 || true
else
    echo "artof-core: could not pull $SYSTEM_IMAGE, keeping the current image" >&2
fi

systemctl daemon-reload
systemctl enable "$SERVICE" >/dev/null 2>&1
systemctl restart "$SERVICE"

exit 0
